{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Microservice1",
        "Uri": "http://localhost:5244/health/live"
      },
      {
        "Name": "Microservice2",
        "Uri": "http://localhost:5026/health/live"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "customer-get-route": {
        "ClusterId": "microservice1-cluster",
        "Match": {
          "Path": "api/Service1/{randomId}",
          "Methods": [ "GET" ]
        }
      },
      "transaction-get-route": {
        "ClusterId": "microservice2-cluster",
        "Match": {
          "Path": "api/Service2/{randomId}",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "microservice1-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5244"
          }
        }
      },
      "microservice2-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5026"
          }
        }
      }
    }
  }
}
